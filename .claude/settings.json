{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-written-file.sh",
            "timeout": 60,
            "statusMessage": "Linting the file just written"
          }
        ]
      }
    ]
  }
}
