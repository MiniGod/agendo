{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // ─────────────────────────────────────────────────────────────────────────
  // A RATCHET, NOT A CLIFF.
  //
  // Every "max" below is pinned to a value that ALREADY HOLDS today, so this
  // config landed green on a codebase nobody had cleaned up yet. The rule is
  // one-directional:
  //
  //     a refactor that makes a number achievable LOWERS it in the same PR,
  //     and a lowered number never goes back up.
  //
  // Raising any threshold, or adding a file to the exemption list at the
  // bottom, is the one change here that needs an argument in the PR
  // description. Everything else about this file is ordinary config.
  //
  // The limits are NOT pinned once globally at the worst file in the tree —
  // that shape leaves every other file free to grow up to the worst one. The
  // `src/**` block below is the real budget, set at the worst value anywhere in
  // src/ OUTSIDE the files carrying a named exemption below. Three of those are
  // the files the refactor effort is dismantling (App.tsx, index.tsx, tmux.ts),
  // and each shrinks or disappears as its PR lands. src/wait.ts joined them in
  // #44 for a different reason: it was SETTING two of the shared numbers from
  // inside `runWait`, so carving it out let both drop for everyone else.
  //
  // Be precise about what that buys: the budget is per GLOB GROUP, so the 24
  // files sharing the `src/**` cap still have headroom below it (src/launch.ts
  // is 840 lines against a 1242 cap, and any of them may add a fresh
  // complexity-34 function). It bounds the blast radius; it does not freeze
  // every file at its current size. If a file starts creeping toward the cap,
  // the answer is its own tighter block here, not a raised budget.
  //
  // Also not running: the type-aware rules. oxlint reports
  // typescript/no-floating-promises, no-base-to-string, await-thenable,
  // unbound-method and restrict-template-expressions as "deny" via the
  // correctness category, but they only execute under `--type-aware`, which
  // needs the oxlint-tsgolint package and which the "lint" script does not
  // pass. So the config reads stricter than it runs. Measured, they would add
  // 12 findings today (6 no-floating-promises, 4 no-base-to-string, 2
  // no-redundant-type-constituents) — worth turning on in its own PR where
  // they can be looked at properly, not folded into a tooling change.
  // ─────────────────────────────────────────────────────────────────────────

  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],

  "categories": {
    "correctness": "error"
  },

  "rules": {
    // Guards the refactor itself. src/ has ZERO import cycles today, and the
    // main risk when a 2000-line file is split into modules that still talk to
    // each other is quietly introducing one. Kept at error so it can never
    // start.
    "import/no-cycle": "error",

    // Ink drives a real React reconciler, so the hook rules apply exactly as
    // they do in the DOM — a wrong dep array here is a stale render or a leaked
    // interval, not a cosmetic nit.
    "react-hooks/rules-of-hooks": "error",

    // These two are warnings ONLY because src/ui/App.tsx has a real backlog of
    // them. The count is capped by --max-warnings in the "lint" script — the
    // same ratchet as above, expressed as a total.
    //
    // Honest accounting as of this commit: 8 counted warnings (5
    // exhaustive-deps + 3 no-array-index-key), plus 2 MORE exhaustive-deps
    // findings at App.tsx:1421 and :1749 that are suppressed by inline
    // disables. Those two predate this PR; this commit adds the `-- <why>` to
    // each, per the escape-hatch rule in CLAUDE.md. True exhaustive-deps total
    // is therefore 7, of which 5 are counted.
    "react-hooks/exhaustive-deps": "warn",
    "react/no-array-index-key": "warn"
  },

  "overrides": [
    {
      // ── the real budget ──────────────────────────────────────────────────
      // Size and complexity limits apply to the APPLICATION only. Spec files
      // are long by nature (a spec is a list, not a design), and e2e/ is frozen
      // byte-for-byte for the duration of the refactor effort, so a threshold
      // there could not be acted on even if it fired.
      //
      // Each number is the worst value in src/ excluding the files with their own
      // block below (App.tsx, index.tsx, tmux.ts, wait.ts), named with the file
      // that currently sets it.
      // Every extension oxlint will parse, not just ts/tsx: a new src/foo.js or
      // src/ui/Bar.jsx would otherwise land with no size budget at all.
      "files": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx", "src/**/*.mjs", "src/**/*.cjs", "src/**/*.mts", "src/**/*.cts"],
      "rules": {
        "max-lines": ["error", { "max": 1242, "skipBlankLines": false, "skipComments": false }], // src/sessions.ts
        "max-lines-per-function": ["error", { "max": 195, "skipBlankLines": false, "skipComments": false }], // src/model.ts
        "complexity": ["error", 34], // src/wait.ts AND src/sessions.ts — carving out
                                     // wait.ts does NOT lower this one; both sit at 34.
        "max-statements": ["error", 52], // src/usageLimit.ts
        "max-params": ["error", 6], // src/usageLimit.ts
        "max-depth": ["error", 6], // src/sessions.ts:975
        "max-nested-callbacks": ["error", 4] // src/sessions.ts:211
      }
    },

    {
      // ── temporary exemption: PR 3 (src/ui/App.tsx, 3624 lines) ───────────
      // Delete a line here every time the split makes it possible. The file is
      // done when this whole block is gone and App.tsx lives inside the budget
      // above.
      "files": ["src/ui/App.tsx"],
      "rules": {
        "max-lines": ["error", { "max": 3624, "skipBlankLines": false, "skipComments": false }],
        // the `App` component itself, line 1185
        "max-lines-per-function": ["error", { "max": 2440, "skipBlankLines": false, "skipComments": false }],
        // the useInput keyboard handler, line 2467 — the single worst function
        // in the codebase on both counts
        "complexity": ["error", 244],
        "max-statements": ["error", 280],
        // pushSession (line 526) and pushPrsByRepo (line 694) — BOTH sit at 10,
        // so lowering this needs both fixed
        "max-params": ["error", 10]
      }
    },

    {
      // ── temporary exemption: PR 4 (src/index.tsx, 2456 lines) ────────────
      "files": ["src/index.tsx"],
      "rules": {
        // RAISED by #44, which needed these lines here: the stall verdict reads the
        // background-agent count off the capture it had already taken (3 sites),
        // `--help` documents the new `wait --json` field and the new default
        // predicate, and `close` refuses a session whose subagents are still
        // running. All three have nowhere else to live — the verdict is computed
        // here, the guard is here and the help text IS this file. Pinned to the
        // exact new size.
        "max-lines": ["error", { "max": 2480, "skipBlankLines": false, "skipComments": false }],
        // `runStatus`, line 859. Carved out of the shared budget rather than
        // setting it: an exempt file must never be what the rest of src/ is
        // measured against, or the whole tree inherits the allowance of the file
        // being dismantled. #44 added 5 lines to it (the stall verdict now reads
        // the background-agent count off the capture it already took, and the ternary
        // that reads it was reshaped to avoid costing a complexity point), and the
        // shared number DROPPED to 195 in the same change, where the worst
        // non-exempt function actually sits.
        "max-lines-per-function": ["error", { "max": 215, "skipBlankLines": false, "skipComments": false }],
        "complexity": ["error", 66],
        "max-statements": ["error", 90]
      }
    },

    {
      // ── src/wait.ts: its own block, so it stops setting everyone's budget ──
      // `runWait` is 248 lines and was what pinned the SHARED
      // max-lines-per-function at 245 — which handed every other file in src/ a
      // 245-line allowance it had no claim to. #44 added 3 lines to it (read the
      // background-agent count off the capture already taken, and report it in
      // `--json`), so rather than raise the shared number to 248 this carves the
      // file out at its true size and drops the shared budget to 195, where the
      // worst function that is NOT already exempt actually sits. Everything
      // except the carved-out files just got 50 lines tighter.
      //
      // Pinned exactly. The extraction that would fix it — lifting the per-target
      // poll body out of `runWait` — is deliberately NOT done here: wait.ts is
      // rewritten wholesale by the in-flight orchestrator PR, and a refactor now
      // is a conflict for no gain. That PR should take this block with it.
      "files": ["src/wait.ts"],
      "rules": {
        "max-lines-per-function": ["error", { "max": 248, "skipBlankLines": false, "skipComments": false }],
        // `runWait` again, and it was setting this one too — the next-worst
        // non-exempt function is usageLimit.ts at 52, so the shared budget drops
        // there. `complexity` is NOT carved out: sessions.ts sits at 34 as well,
        // so moving wait.ts would not lower the shared number and pretending
        // otherwise would just hide who sets it.
        "max-statements": ["error", 65]
      }
    },

    {
      // ── temporary exemption: PR 2 (src/tmux.ts, 2301 lines) ──────────────
      // Note it needs exactly ONE line: tmux.ts is a big file made of
      // reasonably sized functions, so only the file-length budget is blown.
      //
      // RAISED 2033 -> 2128 by the #39 fix, which is the one change in this file
      // that needs an argument. That fix adds real API surface — the `LiveTarget`
      // /`ManagedTarget` pair, `windowTarget()`, and three lookups that grew from
      // one-line set builders into loops that carry the session qualifier — and
      // there is no honest way to add it inside the old budget. It is pinned to
      // the exact new size, not rounded up, and the PR that splits this file
      // deletes this block outright rather than lowering it.
      //
      // RAISED AGAIN 2128 -> 2301 by the #44 fix, and this is the second
      // consecutive PR to grow this file. The fix splits one overloaded flag in
      // two. `liveStatusLines` became `liveStatusRegions`, returning the bands
      // above and below the input box separately so the busy check can read the
      // live token counter from the band that has one; `paneBackgroundAgents` and
      // `sessionFinished` are new; and the rest is doc comments. Two rounds of
      // review rejected a shape test for the agent panel here — first by glyph,
      // then by its trailing token column — and the reasoning for why there is no
      // shape test at all now is most of the added lines. That reasoning is the
      // part worth keeping. Pinned exactly.
      "files": ["src/tmux.ts"],
      "rules": {
        "max-lines": ["error", { "max": 2301, "skipBlankLines": false, "skipComments": false }]
      }
    },

    {
      // ── ANSI parsing ─────────────────────────────────────────────────────
      // This is a terminal tool: matching ESC/CSI/control bytes in pane output
      // is the actual job. Scoped to the files that genuinely do it, so a stray
      // control byte in an unrelated regex still gets caught.
      "files": ["src/tmux.ts", "src/ui/App.tsx", "e2e/detection.spec.ts"],
      "rules": {
        "no-control-regex": "off"
      }
    },

    {
      // ── e2e freeze carve-outs ────────────────────────────────────────────
      // e2e/ is frozen for the refactor effort: an untouched suite passing
      // against a rearranged src/ is the evidence that nothing regressed, so
      // not one byte of it may change — including to satisfy a linter.
      //
      // Scoped to the exact files with findings rather than all of e2e/, so the
      // rest of the suite stays covered. Both are real and both are one-line
      // deletions once e2e/ is writable again:
      //   e2e/provider.spec.ts:13    unused import `mkdirSync`
      //   e2e/cli.spec.ts:1678       unused fixture param `mock` (wants `_mock`)
      "files": ["e2e/provider.spec.ts", "e2e/cli.spec.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },

    {
      // Playwright's own fixture shapes, not our code:
      //   `async ({}, use)`  — required to declare zero fixture dependencies
      //   `use(...)`         — the injection callback, which every hook rule
      //                        reads as a hook called outside a component
      // There is no React in e2e/ at all, so these are pure false positives.
      "files": ["e2e/**"],
      "rules": {
        "no-empty-pattern": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ]
}
