{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // ─────────────────────────────────────────────────────────────────────────
  // A RATCHET, NOT A CLIFF.
  //
  // Every "max" below is pinned to a value that ALREADY HOLDS today, so this
  // config landed green on a codebase nobody had cleaned up yet. The rule is
  // one-directional:
  //
  //     a refactor that makes a number achievable LOWERS it in the same PR,
  //     and a lowered number never goes back up.
  //
  // Raising any threshold, or adding a file to the exemption list at the
  // bottom, is the one change here that needs an argument in the PR
  // description. Everything else about this file is ordinary config.
  //
  // The limits are NOT pinned once globally at the worst file in the tree —
  // that shape leaves every other file free to grow up to the worst one. The
  // `src/**` block below is the real budget, set at the worst value anywhere in
  // src/ that the exemption blocks do not already cover. The files this refactor
  // effort is dismantling carried named, temporary exemptions, and each shrank or
  // disappeared as its PR landed. `src/tmux.ts` was the first to go; `src/index.tsx`
  // was the last, and with it every whole-file exemption in this config. What is
  // left below are two per-FUNCTION blocks (src/ui/App.tsx, src/cli/send.ts,
  // src/cli/close.ts) and one max-params block — no file in src/ is exempt from
  // the shared max-lines any more. That matters because an exemption block lifts
  // only the rules it NAMES: every other rule falls through to the shared budget,
  // so a file with a max-lines carve-out was still measured on complexity.
  //
  // Be precise about what that buys: the budget is per GLOB GROUP, so the 103
  // files sharing the `src/**` cap still have headroom below it (src/launch.ts
  // is 840 lines against a 1036 cap, and any of them may add a fresh
  // complexity-34 function). It bounds the blast radius; it does not freeze
  // every file at its current size. If a file starts creeping toward the cap,
  // the answer is its own tighter block here, not a raised budget.
  //
  // Also not running: the type-aware rules. oxlint reports
  // typescript/no-floating-promises, no-base-to-string, await-thenable,
  // unbound-method and restrict-template-expressions as "deny" via the
  // correctness category, but they only execute under `--type-aware`, which
  // needs the oxlint-tsgolint package and which the "lint" script does not
  // pass. So the config reads stricter than it runs. Measured, they would add
  // 12 findings today (6 no-floating-promises, 4 no-base-to-string, 2
  // no-redundant-type-constituents) — worth turning on in its own PR where
  // they can be looked at properly, not folded into a tooling change.
  // ─────────────────────────────────────────────────────────────────────────

  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],

  "categories": {
    "correctness": "error"
  },

  "rules": {
    // Guards the refactor itself. src/ has ZERO import cycles today, and the
    // main risk when a 2000-line file is split into modules that still talk to
    // each other is quietly introducing one. Kept at error so it can never
    // start.
    "import/no-cycle": "error",

    // Ink drives a real React reconciler, so the hook rules apply exactly as
    // they do in the DOM — a wrong dep array here is a stale render or a leaked
    // interval, not a cosmetic nit.
    "react-hooks/rules-of-hooks": "error",

    // These two are warnings ONLY because src/ui/App.tsx has a real backlog of
    // them. The count is capped by --max-warnings in the "lint" script — the
    // same ratchet as above, expressed as a total.
    //
    // Honest accounting: ZERO counted warnings — `lint` runs at
    // --max-warnings 0, so either of these firing anywhere now fails the build.
    // Four findings are suppressed by single-line disables, each carrying its
    // `-- <why>` per the escape-hatch rule in CLAUDE.md:
    //
    //   exhaustive-deps    src/ui/hooks/useAuthProbe.ts        probe-on-open
    //   exhaustive-deps    src/ui/hooks/useActivityWatchers.ts id-set digest
    //   no-array-index-key src/ui/components.tsx               column layout
    //   no-array-index-key src/ui/screens/CloneScreen.tsx      error lines
    //
    // The two index-key ones are deliberate: in both the index IS the identity
    // (a fixed positional column layout; a two-line list replaced wholesale),
    // and the available alternative key is not unique, so keying by it would
    // print a duplicate-key warning into the terminal the TUI is drawing on.
    // These stay warnings rather than errors so that a CARELESS new instance
    // shows up as a warning to be judged, not as a wall to be climbed with a
    // blanket disable.
    "react-hooks/exhaustive-deps": "warn",
    "react/no-array-index-key": "warn"
  },

  "overrides": [
    {
      // ── the real budget ──────────────────────────────────────────────────
      // Size and complexity limits apply to the APPLICATION only. Spec files
      // are long by nature (a spec is a list, not a design), and e2e/ is frozen
      // byte-for-byte for the duration of the refactor effort, so a threshold
      // there could not be acted on even if it fired.
      //
      // Each number is the worst value in src/ not already covered by an exemption
      // block below FOR THAT RULE, named with the file and function that sets it.
      // The per-rule part is the whole point: an exemption block replaces only the
      // rules it names and lets every other rule fall through to this budget. The
      // standing illustrations were src/tmux.ts (which named only max-lines and
      // answered to every other size rule) and src/index.tsx (which named all four).
      // Both are now facades or directories, and neither has a block any more.
      // Verified against the installed oxlint rather than assumed from eslint's
      // semantics.
      // Every extension oxlint will parse, not just ts/tsx: a new src/foo.js or
      // src/ui/Bar.jsx would otherwise land with no size budget at all.
      "files": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx", "src/**/*.mjs", "src/**/*.cjs", "src/**/*.mts", "src/**/*.cts"],
      "rules": {
        // DROPPED 515 -> 486. model.ts set this and is now 230: the shapes, the
        // live-tmux read and the repo-scope filters are separate modules under
        // src/model/.
        //
        // This is the end of the run that started at 1036. NOTHING in src/ is over
        // 500 lines any more — src/index.tsx, the last one, is now 109 — and the
        // budget is pinned where the worst remaining file actually is
        // (src/activity.ts at 486) rather than at the round number, because a cap
        // with slack in it is a cap every other file can grow into.
        "max-lines": ["error", { "max": 486, "skipBlankLines": false, "skipComments": false }], // src/activity.ts
        // `runStatus` used to set this from inside index.tsx's own block, at 215.
        // It is now four functions in src/cli/status.ts, the largest well under
        // this cap, so the number is src/cli/send.ts's alone.
        "max-lines-per-function": ["error", { "max": 198, "skipBlankLines": false, "skipComments": false }], // src/cli/send.ts runSend
        // Was also src/wait.ts at 34; `runWait` is now complexity 3, and 34 is a
        // three-way tie between src/activity.ts `claudeAction`, src/activity.ts
        // `loadCodexActivity` and src/ui/components.tsx `SessionRow`. Three
        // separate refactors have to land before this one can move at all.
        // (The first two moved out of src/sessions.ts with the activity split;
        // neither changed.)
        "complexity": ["error", 34], // src/activity.ts claudeAction / loadCodexActivity, src/ui/components.tsx SessionRow
        "max-statements": ["error", 61], // src/ui/keys/list.ts handleListViewKeys
        "max-params": ["error", 6], // src/usageLimit.ts
        "max-depth": ["error", 6], // src/activity.ts:219
        "max-nested-callbacks": ["error", 4] // src/sessions.ts:212
      }
    },

    {
      // ── temporary exemption: src/ui/App.tsx ─────────────────────────────
      // Delete a line here every time the split makes it possible. The file is
      // done when this whole block is gone and App.tsx lives inside the budget
      // above.
      "files": ["src/ui/App.tsx"],
      "rules": {
        // NOTE: no max-lines here. App.tsx is 450 lines and lives well inside
        // the shared src/** budget, which it no longer sets. What remains below
        // is about the `App` FUNCTION, not the file.
        //
        // `App` itself: the mode screens are in src/ui/screens/, the key handlers
        // in src/ui/keys/, ten hooks in src/ui/hooks/, and the action closures in
        // src/ui/cloneActions.ts, src/ui/convertAgent.ts, src/ui/sessionFlow.ts
        // and src/ui/profileActions.ts. The render itself is now two modules:
        // src/ui/screens/ModeScreens.tsx (every overlay) and
        // src/ui/screens/ListScreen.tsx (the list). What is left in `App` is the
        // state, the hook calls and the wiring between them — which is why the
        // remaining 396 is stubborn: it is a component's body, not a backlog.
        // DROPPED 946 -> 396 and 104 -> 69. `App` is still the worst function
        // here and still the only reason this block exists.
        "max-lines-per-function": ["error", { "max": 396, "skipBlankLines": false, "skipComments": false }],
        "max-statements": ["error", 69]
        // NOTE: no complexity line here any more. It was 47, set by `App`; `App`
        // is now complexity 8, and the worst function left in the file is the
        // useInput handler at 14 — comfortably inside the shared budget of 34,
        // so the exemption is deleted rather than lowered.
      }
    },

    {
      // ── temporary exemption: src/ui/rows.ts ──────────────────────────────
      // The row builders take long positional argument lists — pushSession and
      // pushPrsByRepo both sit at 10. They came out of App.tsx unchanged; the
      // signatures are a separate cleanup from the extraction that moved them.
      // One named block here, deliberately, rather than six disable comments
      // scattered through the file: a threshold you can see is a threshold you
      // can ratchet.
      "files": ["src/ui/rows.ts"],
      "rules": {
        "max-params": ["error", 10]
      }
    },

    {
      // ── inherited exemptions: src/cli/send.ts, src/cli/close.ts ──────────
      // NOT new debt, and NOT a raised threshold: `runSend` and `runClose` had
      // exactly these shapes while they sat in index.tsx, where its blanket
      // complexity-66 exemption covered them silently. Moving them out is what
      // made them visible, and pinning them here is strictly TIGHTER than the
      // status quo — a cap of 66 spread across 2456 lines becomes 49 on 224
      // lines and 40 on 287, with index.tsx's own 66 now confined to a third of
      // its former reach.
      //
      // Decomposing them is real work on live control flow (`runSend` alone
      // drives the socket path, the tmux fallback and the readiness wait), not
      // the motion this PR is doing. They are the next two ratchet targets.
      // One block each, not one shared block: pinning both files together
      // would set complexity at close.ts's 49 and hand send.ts nine points of
      // free growth it has not earned. Same reason the `src/**` budget is not
      // pinned at the worst file in the tree.
      "files": ["src/cli/send.ts"],
      "rules": {
        "complexity": ["error", 40], // runSend
        "max-statements": ["error", 74] // runSend
      }
    },

    {
      "files": ["src/cli/close.ts"],
      "rules": {
        // LOWERED 49 -> 47. #44's close guard (refuse a session whose subagent is
        // still writing) landed on master while this was in flight and would have
        // pushed `runClose` to 53 inline; lifting it into `refuseIfWorkInFlight`
        // paid for itself and then some. Statements are inside the shared budget.
        "complexity": ["error", 47] // runClose
      }
    },

    {
      // ── ANSI parsing ─────────────────────────────────────────────────────
      // This is a terminal tool: matching ESC/CSI/control bytes in pane output
      // is the actual job. Scoped to the files that genuinely do it, so a stray
      // control byte in an unrelated regex still gets caught.
      // Narrowed from `src/tmux.ts` when it was split: of the twelve modules the
      // file became, exactly two match control bytes, so the other ten are now
      // covered by the rule again rather than riding on their old neighbour's
      // exemption.
      "files": ["src/tmux/pane.ts", "src/tmux/inputBox.ts", "src/ui/keys/clone.ts", "e2e/detection.spec.ts"],
      "rules": {
        "no-control-regex": "off"
      }
    },

    {
      // ── e2e freeze carve-outs ────────────────────────────────────────────
      // e2e/ is frozen for the refactor effort: an untouched suite passing
      // against a rearranged src/ is the evidence that nothing regressed, so
      // not one byte of it may change — including to satisfy a linter.
      //
      // Scoped to the exact files with findings rather than all of e2e/, so the
      // rest of the suite stays covered. Both are real and both are one-line
      // deletions once e2e/ is writable again:
      //   e2e/provider.spec.ts:13    unused import `mkdirSync`
      //   e2e/cli.spec.ts:1678       unused fixture param `mock` (wants `_mock`)
      "files": ["e2e/provider.spec.ts", "e2e/cli.spec.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },

    {
      // Playwright's own fixture shapes, not our code:
      //   `async ({}, use)`  — required to declare zero fixture dependencies
      //   `use(...)`         — the injection callback, which every hook rule
      //                        reads as a hook called outside a component
      // There is no React in e2e/ at all, so these are pure false positives.
      "files": ["e2e/**"],
      "rules": {
        "no-empty-pattern": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ]
}
