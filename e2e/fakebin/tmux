#!/usr/bin/env node
// Fake `tmux` for the e2e harness. It never starts a real tmux server: list
// commands are answered from a JSON state file (FAKE_TMUX_STATE) and every
// invocation is appended to a call log (FAKE_TMUX_LOG) so tests can assert what
// the launcher tried to do. Mutating commands (new-session/new-window) update
// the state so a subsequent reload reflects them, but run nothing.
import fs from "node:fs";

const argv = process.argv.slice(2);
const STATE = process.env.FAKE_TMUX_STATE;
const LOG = process.env.FAKE_TMUX_LOG;

function readState() {
  try {
    const s = JSON.parse(fs.readFileSync(STATE, "utf-8"));
    return {
      // Spread first so a key this stub doesn't know about survives the
      // read-modify-write a queued `capture-pane` does (see captureQueue).
      ...s,
      sessions: s.sessions ?? [],
      windows: s.windows ?? [],
      panes: s.panes ?? [],
      captures: s.captures ?? {},
      // Per-target QUEUE of captures, consumed one per `capture-pane` call and
      // falling back to `captures` once empty. Lets a test script a pane that
      // CHANGES between reads — a dialog that clears once answered, a box that
      // only appears on the third look — without racing a wall-clock timer.
      captureQueue: s.captureQueue ?? {},
      // Per-target caret position ({x, y}), served to `display-message
      // '#{cursor_x} #{cursor_y}'` — the second signal the input-box classifier
      // reads (a greyed-out suggestion leaves the caret at the prompt).
      cursors: s.cursors ?? {},
      // Optional per-location override of `#{window_name}` (`{"agendo:3": "…"}`),
      // letting a fixture say a `session:index` holds a DIFFERENT window than the
      // window list does. That divergence is real — tmux renumbers windows when
      // one closes under `renumber-windows on`, so an index resolved by one
      // command can name something else by the next — and no static state file
      // can otherwise express a change *between* two commands.
      windowAt: s.windowAt ?? {},
      // Targets whose `capture-pane` FAILS (exit 1, no output), keyed by the raw
      // `-t` value (`{"=agendo:3": true}`). Real tmux fails a capture whose pane
      // it can't reach — the pane exited between a listing and the read, or the
      // server is too loaded to answer — and that is a different thing from a
      // pane that is merely blank. No static screen text can express it, since
      // the difference lives in the exit status, not the output.
      captureFails: s.captureFails ?? {},
      // Width in columns reported for `display-message '#{pane_width}'`, which
      // decides whether the pane a split would cut in two is wide enough to hold
      // the agendo menu and the global orchestrator side by side. Defaults to a normal-sized terminal so the split
      // path is what a fixture gets without saying anything; set it to a small
      // number for the narrow-terminal fallback, or to 0 for the "can't measure
      // it" one (tmux answers an unresolvable target with no output, and agendo
      // reads any non-positive answer as unmeasurable either way).
      paneWidth: s.paneWidth ?? 200,
      // Makes `split-window` fail the way a real server does when the window has
      // no room left for another pane. Not expressible any other way: the whole
      // signal is the exit status.
      splitFails: s.splitFails ?? false,
      // NB the `@cl_*` window tag is not a top-level key: it lives on each
      // window/pane record as `tags: {"@cl_session_id": "…"}`, set either by a
      // fixture directly or by `set-option -w` below.
    };
  } catch {
    // Also the mid-write case: setTmuxState rewrites the file non-atomically
    // while a launcher polls, so every key a command reads must be present here.
    return { sessions: [], windows: [], panes: [], captures: {}, cursors: {}, captureQueue: {}, paneWidth: 200, splitFails: false };
  }
}
function writeState(s) {
  try { fs.writeFileSync(STATE, JSON.stringify(s, null, 2)); } catch {}
}
/** Write back just one target's remaining queue, onto the file as it is NOW. */
function consumeQueue(target, rest) {
  try {
    const s = JSON.parse(fs.readFileSync(STATE, "utf-8"));
    s.captureQueue = { ...(s.captureQueue ?? {}), [target]: rest };
    fs.writeFileSync(STATE, JSON.stringify(s, null, 2));
  } catch {}
}
function log() {
  if (!LOG) return;
  try { fs.appendFileSync(LOG, JSON.stringify(argv) + "\n"); } catch {}
}

// Value passed to a flag (e.g. flag("-t") -> the arg after -t), or undefined.
function flag(name) {
  const i = argv.indexOf(name);
  return i >= 0 ? argv[i + 1] : undefined;
}
// The -F format template, if present.
function format() {
  return flag("-F");
}
/**
 * Resolve a `-t` target the way real tmux does, against a list of candidate
 * names: a leading `=` pins resolution to an EXACT match, otherwise exact wins
 * and a prefix/fnmatch match is accepted next. Returns the matched name, or
 * undefined. Managed names are prefixes of each other (`cl-pr-5`⊂`cl-pr-50`), so
 * this is what makes a bare (unpinned) target bind to the wrong window here just
 * as it would on a real server.
 */
function resolveTarget(target, names) {
  let t = target ?? "";
  const exactOnly = t.startsWith("=");
  if (exactOnly) t = t.slice(1);
  if (names.includes(t)) return t;
  if (exactOnly) return undefined;
  // Real tmux needs the prefix match to be UNIQUE — "multiple matches produce an
  // error" (man tmux, target-session) — so an ambiguous prefix resolves to
  // nothing here rather than to whichever name happens to be listed first.
  const hits = [...new Set(names.filter((n) => n.startsWith(t)))];
  return hits.length === 1 ? hits[0] : undefined;
}

/**
 * The session a `show-options`/`set-option` `-t` value addresses, or undefined
 * if tmux would reject it.
 *
 * These take a target-PANE. `=name` alone is not one — no colon, so tmux never
 * reaches the session lookup and errors on the literal string. `=name:` and a
 * bare `name` both resolve; the `=` keeps it to an exact match, a bare name may
 * fall through to a unique prefix, exactly as `resolveTarget` models elsewhere.
 */
function sessionOptionTarget(state, target) {
  const t = target ?? "";
  const colon = t.indexOf(":");
  if (t.startsWith("=") && colon === -1) return undefined;
  const spec = colon === -1 ? t : t.slice(0, colon);
  return resolveTarget(spec, state.sessions);
}

/** The `{session, window}` a pane-id target (`%N`) names, or undefined. */
function paneWindow(state, target) {
  if (!/^%\d+$/.test(target ?? "")) return undefined;
  const pane = state.panes.find((p) => p.id === target);
  return pane ? { session: pane.session, window: pane.window } : undefined;
}

/** Every window name in the state, however the fixture spelled it. */
function windowNames(state) {
  return [
    ...state.windows.flatMap((w) => [w.name, w.window].filter(Boolean)),
    ...state.panes.map((p) => p.window).filter(Boolean),
  ];
}

/**
 * Reduce a `-t` value to the plain window/session name the fixtures key their
 * captures and cursors by: drop the `=` pin, and resolve the `session:window`
 * form (which agendo uses to address a launcher tab unambiguously) to the window
 * it names — by index, as real tmux resolves `mysession:1`, or by name.
 * Falls back to the raw value so the historical bare-name form keeps working.
 */
function targetName(state, target) {
  const t = target ?? "";
  const colon = t.indexOf(":");
  if (colon === -1) return t.startsWith("=") ? t.slice(1) : t;
  const session = resolveTarget(t.slice(0, colon), state.sessions);
  const win = t.slice(colon + 1);
  const inSession = state.windows.filter((w) => w.session === session);
  const byIndex = /^\d+$/.test(win) ? inSession.find((w) => String(w.index) === win) : undefined;
  const hit = byIndex ?? inSession.find((w) => (w.name ?? w.window) === win.replace(/^=/, ""));
  return hit ? hit.name ?? hit.window : win.replace(/^=/, "");
}

/** The index of the window a PANE record sits in, from that window's record. */
function windowIndexOf(pane) {
  const w = state.windows.find((w) => w.session === pane.session && (w.name ?? w.window) === pane.window);
  return w?.index ?? 0;
}

/**
 * The window id (`@N`) of window `window` in `session`. Derived from the two
 * names rather than stored, so it is stable across every state rewrite and
 * distinct between windows — which is all `agendo focus` needs of it: the id it
 * switches a client to must be the one of the window it meant.
 */
function windowIdOf(session, window) {
  let h = 7;
  for (const ch of `${session}\0${window}`) h = (h * 31 + ch.codePointAt(0)) % 99991;
  return `@${h + 1}`;
}

/**
 * The `{session, window}` a target-PANE value names: a pane id, an exact
 * `=session:=window`, or `=session:` (that session's current window — the first
 * one this stub knows of). Undefined when nothing matches.
 */
function windowAtTarget(state, target) {
  const byPane = paneWindow(state, target);
  if (byPane) return byPane;
  const t = target ?? "";
  if (!t.includes(":")) return undefined;
  const session = sessionOptionTarget(state, t);
  if (session === undefined) return undefined;
  const bare = t.slice(t.indexOf(":") + 1);
  const records = [...state.windows.map((w) => ({ session: w.session, window: w.name ?? w.window })), ...state.panes];
  const hit = records.find((r) => r.session === session && (bare === "" || r.window === targetName(state, t)));
  return hit ? { session, window: hit.window } : undefined;
}

function emit(fmt, record) {
  return fmt
    .replace(/#\{session_name\}/g, record.session ?? "")
    // A pane record carries no index of its own; its window's record does. Real
    // tmux reports the window's index on every pane line, and adoption counts
    // panes per window BY that index (two hand-opened windows are both named
    // after their command), so a pane has to answer with its window's.
    .replace(/#\{window_index\}/g, () => String(record.index ?? windowIndexOf(record)))
    // Window records are written either way round — a pane carries `window`, a
    // window record its `name` — and both stand for the window's name (the
    // has-session/kill-window target lookups accept both too).
    .replace(/#\{window_name\}/g, record.window ?? record.name ?? "")
    .replace(/#\{pane_current_path\}/g, record.cwd ?? "")
    .replace(/#\{pane_dead\}/g, record.dead ? "1" : "0")
    // The placeholder conditional `#{?@cl_placeholder,1,0}` → the pane's flag.
    .replace(/#\{\?@cl_placeholder,1,0\}/g, record.placeholder ? "1" : "0")
    // The same conditional over the PANE option, asked when deciding whether the
    // menu window still runs a menu or only the orchestrator parked beside it.
    .replace(/#\{\?@cl_pane_target,1,0\}/g, record.paneTarget ? "1" : "0")
    // A pane's own id and its `@cl_pane_target` option — how a session parked in
    // somebody else's window (the global orchestrator, beside the menu) is found
    // at all: it owns no window, so its managed name lives on the pane.
    .replace(/#\{pane_id\}/g, record.id ?? "")
    .replace(/#\{@cl_pane_target\}/g, record.paneTarget ?? "")
    // The `@cl_*` WINDOW TAG, read back as a bare `#{@cl_…}` reference. Verified
    // against tmux 3.4: a bare reference to an UNSET user option renders as the
    // empty string and does not fail the command (unlike `show-options -v`,
    // which exits 1 with "invalid option") — which is the whole reason one
    // format can serve tagged and untagged windows alike. Stored per record by
    // `set-option -w` below, and settable directly by a fixture.
    .replace(/#\{(@cl_(?:session_id|source|acquired|branch|pr|item))\}/g, (_, opt) => (record.tags ?? {})[opt] ?? "");
}

// ── a simulated codex pane ────────────────────────────────────────────────────
// `state.codexSim[<window name>]` turns that window into a small codex 0.163. Its
// screen is `template` (a real capture) with the input box and the status bar's
// run-state redrawn from the sim's own state. `paste-buffer` types into the box
// and `send-keys … Enter` submits it. Each `capture-pane` is one tick of the
// sim's clock, so a spec can script the races `agendo send` has to survive
// without a wall-clock timer. The knobs:
//   ingestReads  captures a paste takes to show in the box (default 1; -1 never).
//                An Enter that arrives first finds the box empty and is lost,
//                which is how a message ends up pasted but never submitted.
//   dropEnters   Enters swallowed outright before one is taken.
//   popup        Enter on a box ending in an `@token` accepts a completion
//                (rewrites the token) instead of submitting.
//   rewrite      the first Enter replaces the whole box with this text instead.
//   holdReads    codex is still starting: a taken Enter leaves the message in
//                the box under `Waiting for startup` for this many captures,
//                and only then submits it.
//   afterEnter   a whole screen every capture shows once an Enter has been
//                pressed — a dialog that opened, say. Nothing is submitted.
//   lagReads     captures that still say `Ready` after a submit (default 2),
//   busyReads    then captures that say `Working` (default 3), then `Ready`.
// The box is drawn one row per line, continuation rows indented two columns, as
// codex draws a multi-line draft. What it did is written back into the sim:
// `submitted` (each message taken) and `events`.
const plainText = (s) => s.replace(/\x1b\[[0-9;]*m/g, "");

function simFor(state, target) {
  const name = targetName(state, target);
  const sim = state.codexSim?.[name];
  if (!sim) return null;
  sim.box ??= "";
  sim.submitted ??= [];
  sim.events ??= [];
  return { name, sim };
}

/** Write one sim back onto the state file as it is NOW (see consumeQueue). */
function saveSim(name, sim) {
  try {
    const s = JSON.parse(fs.readFileSync(STATE, "utf-8"));
    s.codexSim = { ...(s.codexSim ?? {}), [name]: sim };
    fs.writeFileSync(STATE, JSON.stringify(s, null, 2));
  } catch {}
}

/** One capture's worth of time: a pending paste lands, a hold ends, a turn advances. */
function simTick(sim) {
  if (sim.pending && sim.pending.reads !== -1 && --sim.pending.reads <= 0) {
    sim.box += sim.pending.text;
    sim.pending = null;
    sim.events.push("ingested");
  }
  if (sim.hold > 0 && --sim.hold === 0) simSubmit(sim);
  sim.working = false;
  if (sim.lag > 0) sim.lag--;
  else if (sim.busy > 0) {
    sim.busy--;
    sim.working = true;
  }
}

function simRows(sim) {
  const lines = sim.template.split("\n");
  const boxRow = lines.findLastIndex((l) => plainText(l).startsWith("›"));
  const barRow = lines.findIndex((l) => plainText(l).includes(" · Ready · "));
  return { lines, boxRow, barRow };
}

function simFrame(sim) {
  if (sim.shown) return sim.shown;
  const { lines, boxRow, barRow } = simRows(sim);
  if (sim.working) lines[barRow] = lines[barRow].replace("Ready", "Working");
  if (sim.hold > 0) lines[barRow + 1] = "  \x1b[1mWaiting for startup\x1b[0m  · \x1b[1mesc\x1b[0m cancel";
  // With a draft in the box, codex clears the hint's left half (codex163-draft).
  else if (sim.box !== "") lines[barRow + 1] = lines[barRow + 1].replace("\x1b[1m?\x1b[0m for shortcuts", " ".repeat(15));
  const [first, ...rest] = sim.box.split("\n");
  lines.splice(boxRow, 1, ...(sim.box === ""
    ? ["\x1b[1m›\x1b[0m \x1b[2mAsk Codex to do anything\x1b[0m"]
    : [`\x1b[1m›\x1b[0m ${first}`, ...rest.map((l) => `  ${l}`)]));
  return lines.join("\n");
}

/** Where the caret sits: the end of the box's last row. */
function simCursor(sim) {
  const rows = sim.box.split("\n");
  return { x: 2 + rows[rows.length - 1].length, y: simRows(sim).boxRow + rows.length - 1 };
}

function simEnter(sim) {
  if (sim.shown) return void sim.events.push("enter-into-screen");
  if (sim.pending || sim.box === "") return void sim.events.push("enter-lost");
  if (sim.dropEnters > 0) {
    sim.dropEnters--;
    return void sim.events.push("enter-dropped");
  }
  if (sim.popup && /(^|\s)@\S+$/.test(sim.box)) {
    sim.box = sim.box.replace(/@\S+$/, "@README.md ");
    return void sim.events.push("completed");
  }
  if (sim.rewrite !== undefined) {
    sim.box = sim.rewrite;
    delete sim.rewrite;
    return void sim.events.push("rewritten");
  }
  if (sim.afterEnter !== undefined) {
    sim.shown = sim.afterEnter;
    return void sim.events.push("screen-changed");
  }
  if (sim.holdReads > 0) {
    if (!(sim.hold > 0)) sim.hold = sim.holdReads;
    return void sim.events.push("held");
  }
  simSubmit(sim);
}

function simSubmit(sim) {
  sim.submitted.push(sim.box.trim());
  sim.box = "";
  sim.lag = sim.lagReads ?? 2;
  sim.busy = sim.busyReads ?? 3;
  sim.events.push("submitted");
}

log();
const cmd = argv[0];
const state = readState();

if (argv.includes("-V")) {
  process.stdout.write("tmux 3.4\n");
  process.exit(0);
}

switch (cmd) {
  case "list-sessions": {
    const fmt = format() ?? "#{session_name}";
    process.stdout.write(state.sessions.map((name) => emit(fmt, { session: name })).join("\n"));
    if (state.sessions.length) process.stdout.write("\n");
    process.exit(0);
  }
  case "list-windows": {
    const fmt = format() ?? "#{window_name}";
    // Real tmux scopes `list-windows -t <session>` to that session (and only `-a`
    // spans every session). Modelled here so code that relies on the scoping —
    // isPlaceholderWindow, which must not read a window option out of a DIFFERENT
    // host session — is actually exercised rather than accidentally passing.
    const target = (flag("-t") ?? "").replace(/^=/, "");
    const windows =
      argv.includes("-a") || !target ? state.windows : state.windows.filter((w) => w.session === target);
    process.stdout.write(windows.map((w) => emit(fmt, w)).join("\n"));
    if (windows.length) process.stdout.write("\n");
    process.exit(0);
  }
  case "list-panes": {
    const fmt = format() ?? "#{pane_current_path}";
    // Real tmux scopes `list-panes -t <window>` to that ONE window, and only `-a`
    // spans the server. Modelled because the launcher asks both ways for
    // different reasons — `-a` to find every managed pane anywhere, `-t
    // =<session>:launcher` to ask whether the menu window still runs a menu — and
    // an unscoped answer would let panes from an unrelated window vouch for it.
    //
    // A pane id as the target names the window that pane is in, as real tmux
    // resolves a `%N` given where a target-window is expected — how adoption
    // asks, right before a kill, whether the pane it is about to kill still sits
    // in a placeholder window.
    const target = flag("-t");
    const byPane = paneWindow(state, target);
    const panes =
      argv.includes("-a") || !target
        ? state.panes
        : byPane
          ? state.panes.filter((p) => p.session === byPane.session && p.window === byPane.window)
          : state.panes.filter(
              (p) => p.session === sessionOptionTarget(state, target) && p.window === targetName(state, target),
            );
    process.stdout.write(panes.map((p) => emit(fmt, p)).join("\n"));
    if (panes.length) process.stdout.write("\n");
    process.exit(0);
  }
  case "kill-pane": {
    // Destructive and modelled for the same reason kill-window is: closing a
    // pane-hosted session must show up as THAT pane disappearing. tmux addresses
    // a pane by its `%N` id, which is unambiguous, so there is no prefix
    // resolution to imitate here. A window whose last pane goes takes the window
    // (and an emptied session) with it, exactly as the server does.
    const id = flag("-t") ?? "";
    const pane = state.panes.find((p) => p.id === id);
    if (!pane) {
      process.stderr.write(`can't find pane: ${id}\n`);
      process.exit(1);
    }
    state.panes = state.panes.filter((p) => p !== pane);
    if (!state.panes.some((p) => p.session === pane.session && p.window === pane.window)) {
      state.windows = state.windows.filter((w) => !(w.session === pane.session && (w.name ?? w.window) === pane.window));
    }
    if (!state.windows.some((w) => w.session === pane.session) && !state.panes.some((p) => p.session === pane.session)) {
      state.sessions = state.sessions.filter((x) => x !== pane.session);
    }
    writeState(state);
    process.exit(0);
  }
  case "capture-pane": {
    // -p prints to stdout; -t <target> selects the pane. We serve the stored
    // capture text for that target (empty string if none). The target is
    // normalized first: agendo reads a launcher tab through its unambiguous
    // `=session:index` location, which must land on the same window a bare name
    // would — a pane read that silently came back empty would read as "unknown"
    // and wave a busy session through the close guard.
    const target = flag("-t");
    // A pane tmux can't read at all: exit non-zero and print nothing, as the real
    // thing does ("can't find pane"). Checked before the queue, since a failed
    // read consumes nothing — the screen it would have shown is still pending.
    if (state.captureFails?.[target ?? ""]) process.exit(1);
    const codex = simFor(state, target);
    if (codex) {
      simTick(codex.sim);
      saveSim(codex.name, codex.sim);
      process.stdout.write(simFrame(codex.sim));
      process.exit(0);
    }
    const queued = state.captureQueue[target];
    if (Array.isArray(queued) && queued.length) {
      const text = queued.shift();
      // Consume it so the next call reads the following one — writing back ONLY
      // the queue, re-read fresh. This is the one command that mutates state
      // while a test may also be calling setTmuxState, and rewriting our whole
      // (older) snapshot would silently roll that back.
      consumeQueue(target, queued);
      process.stdout.write(text);
      process.exit(0);
    }
    const text = state.captures[targetName(state, target)] ?? "";
    process.stdout.write(text);
    process.exit(0);
  }
  case "display-message": {
    // -p prints to stdout. Only the caret format is answered (from
    // state.cursors[target]); every other format prints nothing, which is how
    // this stub has always answered `#{session_name}` (⇒ currentSessionName null).
    const fmt = argv[argv.length - 1] ?? "";
    const target = flag("-t");
    // `#{window_id}\t#{session_name}` at a target: which window a session's
    // target lives in, as `agendo focus` asks before switching a client there.
    // Unresolvable targets print nothing and fail, as tmux does.
    if (fmt.includes("#{window_id}")) {
      const at = windowAtTarget(state, target);
      if (!at) process.exit(1);
      process.stdout.write(`${windowIdOf(at.session, at.window)}\t${at.session}\n`);
      process.exit(0);
    }
    const codex = simFor(state, target);
    const cursor = (codex && simCursor(codex.sim)) ?? state.cursors?.[targetName(state, target)];
    if (fmt.includes("#{cursor_x}") && cursor) process.stdout.write(`${cursor.x} ${cursor.y}\n`);
    // How wide the pane a split would cut in two is (see state.paneWidth).
    else if (fmt.includes("#{pane_width}")) process.stdout.write(`${state.paneWidth}\n`);
    // `#{session_name}` with no -t is "which session am I in" (currentSessionName).
    // Answered ONLY when a fixture says so: printing nothing is what this stub has
    // always done, and several tests depend on that reading back as "unknown".
    else if (fmt.includes("#{session_name}") && target === undefined) {
      if (state.currentSession) process.stdout.write(`${state.currentSession}\n`);
    }
    // `#{window_name}` at a `session:index` location — what agendo re-reads right
    // before a kill to prove the index still names the window it resolved.
    // Prints nothing when the location holds no window, as tmux does on an
    // unresolvable target.
    else if (fmt.includes("#{window_name}") && target !== undefined) {
      const at = state.windowAt?.[target.replace(/^=/, "")];
      const name = at ?? targetName(state, target);
      if (at || windowNames(state).includes(name)) process.stdout.write(`${name}\n`);
    }
    process.exit(0);
  }
  case "list-clients": {
    // The attached clients a fixture declares in `state.clients` — each
    // `{name, pid, activity, session, control}` — which `agendo focus` reads to
    // pick the terminal to move. None declared means nothing is attached.
    const fmt = format() ?? "#{client_name}";
    const clients = state.clients ?? [];
    const line = (c) =>
      fmt
        .replace(/#\{client_activity\}/g, String(c.activity ?? 0))
        .replace(/#\{client_name\}/g, c.name ?? "")
        .replace(/#\{client_pid\}/g, String(c.pid ?? 0))
        .replace(/#\{client_session\}/g, c.session ?? "")
        .replace(/#\{client_control_mode\}/g, c.control ? "1" : "0");
    process.stdout.write(clients.map(line).join("\n"));
    if (clients.length) process.stdout.write("\n");
    process.exit(0);
  }
  case "has-session": {
    // Mirror real tmux target resolution so the `=`-exact fix is actually
    // exercised: a bare `-t <name>` resolves by exact, then unique prefix, then
    // fnmatch; a leading `=` pins it to an exact match only. Managed names are
    // prefixes of each other (`cl-pr-5`⊂`cl-pr-50`), so bare resolution would
    // bind the shorter name to the longer live target — the T1 bug.
    const names = [...state.sessions, ...state.windows.flatMap((w) => [w.name, w.window].filter(Boolean))];
    // Historically this lookup ignores window names a fixture spells only on a
    // pane, so it stays on the narrower set the has-session callers were written
    // against (kill-window uses the full one — see windowNames).
    process.exit(resolveTarget(flag("-t"), names) !== undefined ? 0 : 1);
  }
  case "kill-window":
  case "kill-session": {
    // Destructive, so modelled rather than stubbed — a mistargeted kill has to
    // show up as the WRONG entry disappearing instead of silently passing.
    //
    // `kill-session` takes a target-session: exact name, else a UNIQUE prefix,
    // else an fnmatch — unless pinned with `=` (man tmux). `kill-window` takes a
    // target-window, `session:window`; with the session omitted the window is
    // looked up in the caller's current session only, which is precisely why
    // agendo resolves a tab to `session:index` before killing it. This stub has
    // no current session to scope by, so a bare window name is looked up across
    // all windows before falling back to a session of that name. That is the one
    // deliberate infidelity here, and it is permissive: it cannot reproduce the
    // miss a bare target suffers on a real server, so the tests pin the target
    // FORM directly (argv assertions) instead of relying on this stub to fail.
    // Unresolvable targets fail the way tmux's "can't find window" does.
    //
    // Killing a session takes its panes with it. Killing a window removes just
    // that window — and the session too if it was the last one, as tmux does.
    const target = flag("-t") ?? "";
    const victim =
      cmd === "kill-session"
        ? resolveTarget(target, state.sessions)
        : target.includes(":")
          ? targetName(state, target)
          : resolveTarget(target, windowNames(state)) ?? resolveTarget(target, state.sessions);
    const live = [...state.sessions, ...windowNames(state)];
    if (victim === undefined || !live.includes(victim)) process.exit(1);
    const asSession = state.sessions.includes(victim);
    state.windows = state.windows.filter((w) => w.name !== victim && w.window !== victim);
    state.panes = state.panes.filter((p) => p.window !== victim && !(asSession && p.session === victim));
    state.sessions = state.sessions.filter(
      (s) => s !== victim && (state.windows.some((w) => w.session === s) || state.panes.some((p) => p.session === s)),
    );
    writeState(state);
    process.exit(0);
  }
  case "new-session": {
    // ...-s <name> -n <window> -c <cwd> -- <argv...>
    const name = flag("-s");
    const cwd = flag("-c");
    if (name && !state.sessions.includes(name)) {
      state.sessions.push(name);
      state.panes.push({ session: name, window: name, cwd: cwd ?? "" });
      writeState(state);
    }
    process.exit(0);
  }
  case "new-window": {
    // A `-t <session>` naming a session the state knows lands the window THERE,
    // at the next free index — what pausing a session relies on to put the paused
    // tab back in the host it was taken from. Anything else keeps the historical
    // catch-all `launcher-session`, which the older specs were written against.
    const name = flag("-n");
    const cwd = flag("-c");
    // Only an explicit `-t` resolves: an empty target prefix-matches every name,
    // which would send a bare `new-window` into whichever session is alone.
    const t = flag("-t");
    const host = t ? resolveTarget(t.replace(/:$/, ""), state.sessions) : undefined;
    if (name && host) {
      const next = Math.max(-1, ...state.windows.filter((w) => w.session === host).map((w) => w.index ?? 0)) + 1;
      state.windows.push({ session: host, index: next, name, cwd: cwd ?? "" });
      state.panes.push({ session: host, window: name, cwd: cwd ?? "", placeholder: false });
      writeState(state);
    } else if (name) {
      state.windows.push({ session: "launcher-session", index: state.windows.length + 1, name });
      state.panes.push({ session: "launcher-session", window: name, cwd: cwd ?? "" });
      writeState(state);
    }
    process.exit(0);
  }
  case "split-window": {
    // `split-window -h -d -P -F '#{pane_id}' -t <window> -c <cwd> -- <argv...>`:
    // the global orchestrator being parked beside the menu. Modelled rather than
    // stubbed because BOTH halves of the answer are load-bearing — the exit
    // status says whether a pane was created at all, and the printed pane id is
    // the only handle anything downstream has on the session that now runs there.
    if (state.splitFails) {
      process.stderr.write("create pane failed: pane too small\n");
      process.exit(1);
    }
    const target = flag("-t") ?? "";
    const colon = target.indexOf(":");
    const session = colon === -1 ? resolveTarget(target.replace(/^=/, ""), state.sessions) : resolveTarget(target.slice(0, colon), state.sessions);
    const window = targetName(state, target);
    // tmux can only split a window it can find; agendo treats that refusal as
    // "open a window instead", so the stub has to be able to produce it.
    if (session === undefined || !windowNames(state).includes(window)) {
      process.stderr.write(`can't find window: ${target}\n`);
      process.exit(1);
    }
    const id = `%${state.nextPaneId ?? state.panes.length + 1}`;
    state.nextPaneId = Number(id.slice(1)) + 1;
    state.panes.push({ session, window, cwd: flag("-c") ?? "", id });
    writeState(state);
    const fmt = format();
    if (argv.includes("-P") && fmt) process.stdout.write(`${emit(fmt, { id })}\n`);
    process.exit(0);
  }
  // Session options (`@cl_root`), modelled rather than stubbed, because the
  // WHOLE bug these two once had lived in the exit status a stub would have
  // thrown away.
  //
  // `show-options`/`set-option` take a target-PANE, not a target-session. A bare
  // `=name` is not valid target-pane syntax and real tmux rejects it outright;
  // `=name:` — the trailing colon naming that session's current pane — is
  // accepted and stays exact-matched. `has-session` takes a target-SESSION and
  // accepts `=name` happily, which is how agendo could confirm a session existed
  // and then silently fail to read or write its option for months.
  //
  // Verified against tmux 3.4 before being written down here:
  //   set-option   -t 'work'   @cl_root /a   → 0
  //   set-option   -t '=work'  @cl_root /a   → 1, "no such session: =work"
  //   set-option   -t '=work:' @cl_root /a   → 0
  //   show-options -t work -v @cl_absent     → 1, "invalid option: @cl_absent"
  case "set-option":
  case "show-options": {
    // Window options (-w) are a different namespace, read back through the list
    // formats (`#{?@cl_placeholder,1,0}`, `#{@cl_session_id}`) and never through
    // show-options. Their `=session:=window` target already carries a colon, so
    // it parses.
    //
    // The `@cl_*` window TAG is stored on the matching window AND on its panes:
    // one real window option is visible from both `list-windows` and
    // `list-panes`, but this stub answers those from two separate record sets,
    // so both have to carry it or the tag would be readable from only one of
    // the two paths that read it. An empty window half (`=session:`) means that
    // session's current window, which for a managed session is its only one.
    //
    // `@cl_placeholder` flags the records of a fully named `session:window`
    // target (a paused tab being marked, below); any other `@cl_placeholder`
    // write keeps the silent success it has always had, the fixtures setting
    // `placeholder` on the record directly. The exit status stays always 0,
    // rather than modelling tmux's "no such window" — because several callers
    // target windows this stub does not model, and failing them would be a new
    // behaviour rather than a more faithful one.
    if (argv.includes("-w")) {
      const target = flag("-t") ?? "";
      const [opt, value] = argv.slice(argv.indexOf("-t") + 2).filter((a) => !a.startsWith("-"));
      // A pane id addresses its own window — how adoption stamps a window it
      // reached through the pane listing, since `%N` is the one handle that
      // cannot prefix-match a neighbour. Real tmux resolves it the same way.
      const byPane = paneWindow(state, target);
      const session = byPane ? byPane.session : sessionOptionTarget(state, target);
      const colon = target.indexOf(":");
      const bare = colon === -1 ? "" : target.slice(colon + 1);
      const window = byPane ? byPane.window : bare === "" ? null : targetName(state, target);
      const hits = (rec, recWindow) =>
        (session === undefined || rec.session === session) && (window === null || recWindow === window);
      // `markPlaceholder` on a window this stub just created (a paused tab):
      // flag its records, so the list formats read it back as a placeholder the
      // way they read a fixture's own `placeholder: true`. Only a fully named
      // `session:window` target, so a stray write can't flag a whole session.
      if (opt === "@cl_placeholder" && session !== undefined && window !== null) {
        for (const rec of [...state.windows, ...state.panes]) if (hits(rec, rec.name ?? rec.window)) rec.placeholder = true;
        writeState(state);
        process.exit(0);
      }
      if (!opt || !/^@cl_(session_id|source|acquired|branch|pr|item)$/.test(opt)) process.exit(0);
      let matched = false;
      for (const w of state.windows) {
        if (!hits(w, w.name ?? w.window)) continue;
        w.tags = { ...(w.tags ?? {}), [opt]: value ?? "" };
        matched = true;
      }
      for (const pane of state.panes) {
        if (!hits(pane, pane.window)) continue;
        pane.tags = { ...(pane.tags ?? {}), [opt]: value ?? "" };
        matched = true;
      }
      if (matched) writeState(state);
      process.exit(0);
    }
    // Pane options (-p) take a target-PANE and the launcher only ever writes one:
    // `@cl_pane_target`, the managed name stamped on a pane so a session with no
    // window of its own is still discoverable. Stored on the pane record, where
    // the list-panes format reads it back from.
    if (argv.includes("-p")) {
      const pane = state.panes.find((x) => x.id === flag("-t"));
      if (!pane) {
        process.stderr.write(`can't find pane: ${flag("-t")}\n`);
        process.exit(1);
      }
      const [opt, value] = argv.slice(argv.indexOf("-t") + 2).filter((a) => !a.startsWith("-"));
      if (opt === "@cl_pane_target") pane.paneTarget = value ?? "";
      writeState(state);
      process.exit(0);
    }
    const target = flag("-t") ?? "";
    const session = sessionOptionTarget(state, target);
    if (session === undefined) {
      process.stderr.write(`no such session: ${target}\n`);
      process.exit(1);
    }
    if (cmd === "set-option") {
      const rest = argv.slice(argv.indexOf("-t") + 2).filter((a) => !a.startsWith("-"));
      const [opt, value] = rest;
      if (opt) {
        state.options = { ...(state.options ?? {}) };
        state.options[session] = { ...(state.options[session] ?? {}), [opt]: value ?? "" };
        writeState(state);
      }
      process.exit(0);
    }
    const opt = flag("-v");
    const value = (state.options ?? {})[session]?.[opt];
    if (value === undefined) {
      // tmux's answer for an unset USER option, and the reason sessionRoot's
      // "no root recorded" and "no such option" collapse to the same null.
      process.stderr.write(`invalid option: ${opt}\n`);
      process.exit(1);
    }
    process.stdout.write(`${value}\n`);
    process.exit(0);
  }
  case "rename-window": {
    // Modelled because adoption is the first thing in the tree to rename a
    // window, and what it renames is the USER's window: a rename that landed on
    // the wrong one — the menu, a launched tab — has to show up as that entry's
    // name changing. The target is a pane id (adoption) or a `session:window`
    // ref; the new name is the last argument. Every pane record of the window
    // follows, since this stub keys captures and kills by the pane's `window`.
    const target = flag("-t") ?? "";
    const name = argv[argv.length - 1];
    const at = paneWindow(state, target);
    const session = at ? at.session : sessionOptionTarget(state, target);
    const window = at ? at.window : targetName(state, target);
    const hit = state.windows.find((w) => (session === undefined || w.session === session) && (w.name ?? w.window) === window);
    if (!hit && !at) {
      process.stderr.write(`can't find window: ${target}\n`);
      process.exit(1);
    }
    for (const w of state.windows) {
      if ((session === undefined || w.session === session) && (w.name ?? w.window) === window) {
        if (w.name !== undefined) w.name = name;
        if (w.window !== undefined) w.window = name;
      }
    }
    for (const pane of state.panes) {
      if ((session === undefined || pane.session === session) && pane.window === window) pane.window = name;
    }
    writeState(state);
    process.exit(0);
  }
  // The paste buffer, kept in the state so `paste-buffer` (a later process) can
  // read back what `set-buffer` stored. Only a simulated codex pane does
  // anything with it, and with no sim in the state these stay the no-ops they
  // always were — not even a state write.
  case "set-buffer": {
    if (!state.codexSim) process.exit(0);
    const name = flag("-b") ?? "default";
    const text = argv[argv.indexOf("--") + 1] ?? argv[argv.length - 1];
    try {
      const s = JSON.parse(fs.readFileSync(STATE, "utf-8"));
      s.buffers = { ...(s.buffers ?? {}), [name]: text };
      fs.writeFileSync(STATE, JSON.stringify(s, null, 2));
    } catch {}
    process.exit(0);
  }
  case "paste-buffer": {
    const codex = simFor(state, flag("-t"));
    const text = state.buffers?.[flag("-b") ?? "default"];
    if (codex && text !== undefined) {
      const reads = codex.sim.ingestReads ?? 1;
      codex.sim.pending = codex.sim.pending ? { ...codex.sim.pending, text: codex.sim.pending.text + text } : { text, reads };
      codex.sim.events.push("paste");
      saveSim(codex.name, codex.sim);
    }
    process.exit(0);
  }
  case "send-keys": {
    const codex = simFor(state, flag("-t"));
    if (codex && argv[argv.length - 1] === "Enter" && !argv.includes("-l")) {
      simEnter(codex.sim);
      saveSim(codex.name, codex.sim);
    }
    process.exit(0);
  }
  // Navigation / config commands: nothing to do, just succeed.
  case "set-window-option":
  case "select-pane":
  case "select-window":
  case "switch-client":
  case "attach-session":
  default:
    process.exit(0);
}
