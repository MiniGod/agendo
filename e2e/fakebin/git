#!/usr/bin/env node
// Fake `git` for the e2e harness — only the operations worktree.ts and clone.ts
// use are implemented, and neither "worktree add" nor "clone" does more than
// create the target directory, so no real repository is ever touched and nothing
// ever goes near the network. Everything is appended to FAKE_CALL_LOG.
import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";

const argv = process.argv.slice(2);
const LOG = process.env.FAKE_CALL_LOG;
if (LOG) { try { fs.appendFileSync(LOG, "git " + JSON.stringify(argv) + "\n"); } catch {} }

// Capture then strip a leading `-C <root>`, and any `-c key=value` after it.
let args = argv.slice();
let root = process.cwd();
if (args[0] === "-C") { root = args[1]; args = args.slice(2); }
while (args[0] === "-c") args = args.slice(2);

// Real-git passthrough, for specs that need genuine repositories (the cleanup
// view judges dirty / unpushed / merged state, which no registry can fake
// honestly). FAKE_GIT_REAL names the real binary and FAKE_GIT_REAL_ROOT a
// fixture directory in the spec's temp dir (the "fence"). It FAILS CLOSED: a
// call is refused loudly — never run against real git and never quietly faked
// — unless everything it could touch resolves inside the fence, so a buggy
// spec cannot `worktree remove` or `branch -D` in a real repository:
//   • the leading global options are walked whole, and only `-C`, `--no-pager`
//     and an allowlisted `-c` are accepted (a `-c alias.x=!cmd`, a hooks path or
//     an fsmonitor would run anything), as are no GIT_CONFIG_* injections and
//     no `git config` at all (it would plant the same thing for the next call);
//     the real run gets fsmonitor and hooks switched off besides;
//   • the `-C` dir, every GIT_DIR-like variable, every later argument and
//     every `--opt=value` value is resolved as a path, symlinks followed before
//     each `..` the way the kernel does, and must land inside the fence;
//   • `-o<path>`-style short options are checked the same way, and anything
//     that looks like a URL (`https://…`, `host:path`) is refused outright;
//   • the repository git would DISCOVER from there (a parent repo, a `.git`
//     gitfile pointing elsewhere) must be inside the fence too, and so must
//     every worktree it has registered (`worktree remove` matches by suffix)
//     and every remote URL it could push to or fetch from; the real run gets
//     GIT_CEILING_DIRECTORIES so discovery cannot climb out of it.
if (process.env.FAKE_GIT_REAL || process.env.FAKE_GIT_REAL_ROOT) {
  const refuse = (why) => {
    process.stderr.write(`fake git: refusing real-git passthrough — ${why}\n`);
    if (LOG) { try { fs.appendFileSync(LOG, "git-refused " + JSON.stringify({ why, argv }) + "\n"); } catch {} }
    process.exit(128);
  };
  const REAL = process.env.FAKE_GIT_REAL;
  if (!REAL || !process.env.FAKE_GIT_REAL_ROOT) refuse("FAKE_GIT_REAL and FAKE_GIT_REAL_ROOT must both be set");
  const realOf = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
  const fence = realOf(process.env.FAKE_GIT_REAL_ROOT);
  const inFence = (p) => p === fence || p.startsWith(fence + path.sep);
  // `p` against `base`, one component at a time, each existing prefix
  // realpath'd BEFORE the next `..` applies — `link/..` is the parent of the
  // link's target, not the link's own directory. A missing tail (a removed
  // worktree) is joined lexically: nothing below it exists to be a symlink.
  const resolveReal = (base, p) => {
    let cur = path.isAbsolute(p) ? "/" : base;
    for (const seg of p.split("/")) {
      if (!seg || seg === ".") continue;
      if (seg === "..") { cur = path.dirname(cur); continue; }
      const next = path.join(cur, seg);
      try { cur = fs.realpathSync(next); } catch { cur = next; }
    }
    return cur;
  };
  for (const k of Object.keys(process.env)) {
    if (/^GIT_CONFIG_(PARAMETERS|COUNT|KEY_|VALUE_)/.test(k)) refuse(`config injection via ${k}`);
  }
  const SAFE_CONFIG = new Set(["commit.gpgsign=false"]);
  let dir = realOf(process.cwd());
  let i = 0;
  for (; i < argv.length && argv[i].startsWith("-"); i++) {
    const a = argv[i];
    if (a === "-C") dir = resolveReal(dir, argv[++i] ?? "");
    else if (a === "-c") { if (!SAFE_CONFIG.has(argv[++i])) refuse(`config -c ${argv[i]} is not allowlisted`); }
    else if (a !== "--no-pager") refuse(`global option ${a} is not allowed`);
  }
  if (!inFence(dir)) refuse(`-C / cwd ${dir} is outside ${fence}`);
  if (argv[i] === "config") refuse("git config can plant commands for later calls");
  for (const name of ["GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"]) {
    const v = process.env[name];
    if (v && !inFence(resolveReal(dir, v))) refuse(`${name} ${v} is outside ${fence}`);
  }
  // Every argument after the subcommand is checked as if it were a path. A ref
  // or a format string resolves to some harmless name under `dir`; only a real
  // escape (`../..`, an absolute path, `--output=/x`) lands outside.
  // A URL — or anything git could read as one (`host:path`) — is never local.
  const urlish = (v) => /^[A-Za-z][\w+.-]*:\/\//.test(v) || /^[^/]*:/.test(v);
  // A remote is a local path or file:// URL inside the fence, or refused.
  const checkUrl = (what, url) => {
    const local = url.replace(/^file:\/\//, "");
    if (urlish(local) || !inFence(resolveReal(dir, local))) refuse(`${what} ${url} is not a path inside ${fence}`);
  };
  for (const a of argv.slice(i)) {
    let v = a;
    if (a.startsWith("--")) v = a.match(/^--[^=]*=([\s\S]*)$/)?.[1];
    else if (a.startsWith("-")) v = a.slice(2); // `-o<dir>`, `-f<file>`: the value rides attached
    if (v && urlish(v)) refuse(`argument ${a} looks like a URL`);
    if (v && !inFence(resolveReal(dir, v))) refuse(`argument ${a} reaches outside ${fence}`);
  }
  // Where would git actually look? Asked WITHOUT a ceiling, so a parent repo
  // above the fence or a gitfile pointing out of it shows up here and is refused
  // rather than silently masked; no repo at all (init, clone) is fine.
  const globals = argv.slice(0, i);
  const ask = (...q) => {
    const r = spawnSync(REAL, [...globals, ...q], { encoding: "utf-8" });
    return r.status === 0 ? r.stdout.split("\n").filter(Boolean) : [];
  };
  for (const q of [["--git-common-dir", "--git-dir"], ["--show-toplevel"]]) {
    for (const line of ask("rev-parse", "--path-format=absolute", ...q)) {
      if (!inFence(realOf(line))) refuse(`git would use ${line}, outside ${fence}`);
    }
  }
  for (const line of ask("worktree", "list", "--porcelain")) {
    const wt = line.match(/^worktree (.+)$/)?.[1];
    if (wt && !inFence(resolveReal(dir, wt))) refuse(`the repo has a worktree at ${wt}, outside ${fence}`);
  }
  for (const line of ask("config", "--get-regexp", "^remote\\..*\\.(push)?url$")) {
    const [key, ...rest] = line.split(" ");
    checkUrl(key, rest.join(" "));
  }
  const ceiling = [fence, process.env.GIT_CEILING_DIRECTORIES].filter(Boolean).join(path.delimiter);
  const off = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"];
  const r = spawnSync(REAL, [...off, ...argv], { stdio: "inherit", env: { ...process.env, GIT_CEILING_DIRECTORIES: ceiling } });
  process.exit(r.status ?? 1);
}

if (args[0] === "init") {
  // `git -C <dest> init --quiet` (initRepo.ts). FAKE_GIT_INIT selects the outcome:
  //   • unset / "ok" → creates <dest>/.git with an unborn HEAD
  //   • "fail"       → exits 128 having written a partial .git, which is what a
  //                    real init leaves behind when it dies mid-way; the cleanup
  //                    of it is initRepo.ts's job, and specs assert it happened
  try { fs.mkdirSync(path.join(root, ".git"), { recursive: true }); } catch {}
  if (process.env.FAKE_GIT_INIT === "fail") {
    process.stderr.write(`fatal: cannot copy '/usr/share/git-core/templates/info' to '${root}/.git/info': Permission denied\n`);
    process.exit(128);
  }
  try { fs.writeFileSync(path.join(root, ".git", "HEAD"), "ref: refs/heads/main\n"); } catch {}
  process.exit(0);
}

if (args[0] === "commit") {
  // The empty initial commit initRepo.ts makes after init. FAKE_GIT_COMMIT=fail
  // is the "no user.name configured" case — the repo exists, the commit doesn't.
  if (process.env.FAKE_GIT_COMMIT === "fail") {
    process.stderr.write("Author identity unknown\n\n*** Please tell me who you are.\n\nfatal: unable to auto-detect email address (got 'ada@box.(none)')\n");
    process.exit(128);
  }
  process.exit(0);
}

if (args[0] === "symbolic-ref") {
  // refs/remotes/origin/HEAD --short -> the default branch ref.
  process.stdout.write("origin/main\n");
  process.exit(0);
}

if (args[0] === "remote" && args[1] === "get-url") {
  // The GitHub backend derives a repo slug from origin. We serve a github.com
  // URL owned by `ada` (the fake gh login) named after the repo's directory, so
  // repoRef resolves `ada/<repo>` — the slug the fake gh keys its fixtures on.
  // FAKE_GIT_ORIGIN_HOST selects the origin host so tests can exercise the
  // path-context provider detection (provider.ts detectRepoProvider):
  //   • unset / "github" → a github.com remote (default; forces the GitHub backend)
  //   • "ado"            → an Azure DevOps remote (leaves the default provider)
  //   • "none"           → no origin at all (non-git / no-remote repo)
  const host = process.env.FAKE_GIT_ORIGIN_HOST;
  if (host === "none") { process.stderr.write("error: No such remote 'origin'\n"); process.exit(1); }
  if (host === "ado") { process.stdout.write(`https://dev.azure.com/innovamps/proj/_git/${path.basename(root)}\n`); process.exit(0); }
  process.stdout.write(`https://github.com/ada/${path.basename(root)}.git\n`);
  process.exit(0);
}

if (args[0] === "clone") {
  // `git clone --progress -- <remote> <dest>`. The positionals are whatever
  // follows the `--` separator clone.ts always passes.
  const sep = args.indexOf("--", 1);
  const [remote, dest] = args.slice(sep + 1);
  // FAKE_GIT_CLONE selects the outcome so specs can drive each branch:
  //   • unset / "ok" → succeeds, creating <dest>/.git
  //   • "auth"       → the HTTPS credentials failure
  //   • "hostkey"    → an unknown SSH host, which BatchMode turns from a prompt
  //                    into a failure — its own category, not "check your creds"
  //   • "sshauth"    → the SSH credentials failure, verbatim from real git: the
  //                    line that says WHY carries no `fatal:` prefix, and the
  //                    `fatal:` summary line reads like a missing repo
  //   • "missing"    → a 404, which must NOT be reported as a credentials problem
  //   • "fail"       → none of the above
  // In every failing case a PARTIAL directory is left behind on purpose: the
  // cleanup of it is clone.ts's job, and specs assert it happened.
  const mode = process.env.FAKE_GIT_CLONE || "ok";
  process.stderr.write(`Cloning into '${dest}'...\n`);
  if (dest) { try { fs.mkdirSync(path.join(dest, ".git"), { recursive: true }); } catch {} }
  // Emit CR-delimited progress like the real thing, so the TUI's progress line
  // (and its parsing of \r-separated chunks) is exercised.
  process.stderr.write("remote: Enumerating objects: 120, done.\r");
  process.stderr.write("Receiving objects: 100% (120/120), 1.10 MiB | 5.00 MiB/s, done.\r\n");
  if (mode === "auth") {
    process.stderr.write(`fatal: could not read Username for '${remote}': terminal prompts disabled\n`);
    process.exit(128);
  }
  if (mode === "hostkey") {
    // What BatchMode turns the "trust this host?" question into. Note it ALSO
    // ends with the generic "Could not read from remote repository." line.
    process.stderr.write("Host key verification failed.\n");
    process.stderr.write("fatal: Could not read from remote repository.\n");
    process.exit(128);
  }
  if (mode === "sshauth") {
    process.stderr.write("git@github.com: Permission denied (publickey).\n");
    process.stderr.write("fatal: Could not read from remote repository.\n\n");
    process.stderr.write("Please make sure you have the correct access rights\nand the repository exists.\n");
    process.exit(128);
  }
  if (mode === "missing") {
    process.stderr.write(`remote: Repository not found.\nfatal: repository '${remote}' not found\n`);
    process.exit(128);
  }
  if (mode === "fail") {
    process.stderr.write("fatal: the remote end hung up unexpectedly\n");
    process.exit(128);
  }
  // A marker the specs can read back to prove WHICH remote was cloned.
  try { fs.writeFileSync(path.join(dest, ".git", "fake-origin"), String(remote)); } catch {}
  process.exit(0);
}

// ── worktree registry ─────────────────────────────────────────────────────────
// `worktree list --porcelain` and `status --porcelain` are what `launch` reads
// before ADOPTING an existing worktree (src/repositories/worktree/adopt.ts), and neither can
// be derived from the directories the fake `worktree add` creates: a test needs
// a worktree that is dirty, on an unexpected branch, or living outside
// `.claude/worktrees/`, and — the case the real bug was about — a directory
// that exists where a worktree would be WITHOUT being one. So the registry is
// explicit: FAKE_GIT_STATE holds `{ worktrees: [{ root, path, branch, dirty }] }`
// (`dirty` is the `status --porcelain` lines), seeded by specs and appended to
// by the fake `worktree add` so a create-then-adopt sequence needs no seeding.
const STATE = process.env.FAKE_GIT_STATE;
function readState() {
  try { return { worktrees: [], ...JSON.parse(fs.readFileSync(STATE, "utf-8")) }; } catch { return { worktrees: [] }; }
}
function real(p) { try { return fs.realpathSync(p); } catch { return p; } }
/** The main checkout `dir` belongs to: a registered root or worktree that is
 *  `dir` or an ancestor of it, else the nearest ancestor holding a `.git`. */
function mainRootOf(dir) {
  const d = real(dir);
  const within = (p) => d === real(p) || d.startsWith(real(p) + "/");
  for (const w of readState().worktrees) {
    if (within(w.root) || within(w.path)) return real(w.root);
  }
  let cur = d;
  while (cur && cur !== "/") {
    if (fs.existsSync(path.join(cur, ".git"))) return cur;
    cur = path.dirname(cur);
  }
  return undefined;
}

if (args[0] === "worktree" && args[1] === "add") {
  // The worktree path is the argument that looks like an absolute path; the
  // branch is `-b`'s value, else the positional after the path (the
  // existing-branch form). Registered so a later `worktree list` finds it.
  const rest = args.slice(2);
  const wt = rest.find((a) => a.startsWith("/"));
  const b = rest.indexOf("-b");
  const branch = b >= 0 ? rest[b + 1] : rest[rest.indexOf(wt) + 1];
  if (wt) {
    try { fs.mkdirSync(wt, { recursive: true }); } catch {}
    if (STATE) {
      const s = readState();
      s.worktrees.push({ root: real(root), path: real(wt), branch: branch ?? "worktree-unnamed", dirty: [] });
      try { fs.writeFileSync(STATE, JSON.stringify(s, null, 2)); } catch {}
    }
  }
  process.exit(0);
}

if (args[0] === "worktree" && args[1] === "list") {
  const main = mainRootOf(root);
  if (!main) {
    process.stderr.write("fatal: not a git repository (or any of the parent directories): .git\n");
    process.exit(128);
  }
  const record = (p, branch) => `worktree ${p}\nHEAD 0000000000000000000000000000000000000000\nbranch refs/heads/${branch}\n\n`;
  let out = record(main, "main");
  for (const w of readState().worktrees) {
    if (real(w.root) === main) out += record(real(w.path), w.branch);
  }
  process.stdout.write(out);
  process.exit(0);
}

if (args[0] === "status") {
  const here = real(root);
  const w = readState().worktrees.find((x) => real(x.path) === here);
  process.stdout.write((w?.dirty ?? []).map((l) => `${l}\n`).join(""));
  process.exit(0);
}

process.exit(0);
