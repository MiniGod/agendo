#!/usr/bin/env node
// Fake `git` for the e2e harness — only the operations worktree.ts and clone.ts
// use are implemented, and neither "worktree add" nor "clone" does more than
// create the target directory, so no real repository is ever touched and nothing
// ever goes near the network. Everything is appended to FAKE_CALL_LOG.
import fs from "node:fs";
import path from "node:path";

const argv = process.argv.slice(2);
const LOG = process.env.FAKE_CALL_LOG;
if (LOG) { try { fs.appendFileSync(LOG, "git " + JSON.stringify(argv) + "\n"); } catch {} }

// Capture then strip a leading `-C <root>`.
let args = argv.slice();
let root = process.cwd();
if (args[0] === "-C") { root = args[1]; args = args.slice(2); }

if (args[0] === "symbolic-ref") {
  // refs/remotes/origin/HEAD --short -> the default branch ref.
  process.stdout.write("origin/main\n");
  process.exit(0);
}

if (args[0] === "remote" && args[1] === "get-url") {
  // The GitHub backend derives a repo slug from origin. We serve a github.com
  // URL owned by `ada` (the fake gh login) named after the repo's directory, so
  // repoRef resolves `ada/<repo>` — the slug the fake gh keys its fixtures on.
  // FAKE_GIT_ORIGIN_HOST selects the origin host so tests can exercise the
  // path-context provider detection (provider.ts detectRepoProvider):
  //   • unset / "github" → a github.com remote (default; forces the GitHub backend)
  //   • "ado"            → an Azure DevOps remote (leaves the default provider)
  //   • "none"           → no origin at all (non-git / no-remote repo)
  const host = process.env.FAKE_GIT_ORIGIN_HOST;
  if (host === "none") { process.stderr.write("error: No such remote 'origin'\n"); process.exit(1); }
  if (host === "ado") { process.stdout.write(`https://dev.azure.com/innovamps/proj/_git/${path.basename(root)}\n`); process.exit(0); }
  process.stdout.write(`https://github.com/ada/${path.basename(root)}.git\n`);
  process.exit(0);
}

if (args[0] === "clone") {
  // `git clone --progress -- <remote> <dest>`. The positionals are whatever
  // follows the `--` separator clone.ts always passes.
  const sep = args.indexOf("--", 1);
  const [remote, dest] = args.slice(sep + 1);
  // FAKE_GIT_CLONE selects the outcome so specs can drive each branch:
  //   • unset / "ok" → succeeds, creating <dest>/.git
  //   • "auth"       → the HTTPS credentials failure
  //   • "hostkey"    → an unknown SSH host, which BatchMode turns from a prompt
  //                    into a failure — its own category, not "check your creds"
  //   • "sshauth"    → the SSH credentials failure, verbatim from real git: the
  //                    line that says WHY carries no `fatal:` prefix, and the
  //                    `fatal:` summary line reads like a missing repo
  //   • "missing"    → a 404, which must NOT be reported as a credentials problem
  //   • "fail"       → none of the above
  // In every failing case a PARTIAL directory is left behind on purpose: the
  // cleanup of it is clone.ts's job, and specs assert it happened.
  const mode = process.env.FAKE_GIT_CLONE || "ok";
  process.stderr.write(`Cloning into '${dest}'...\n`);
  if (dest) { try { fs.mkdirSync(path.join(dest, ".git"), { recursive: true }); } catch {} }
  // Emit CR-delimited progress like the real thing, so the TUI's progress line
  // (and its parsing of \r-separated chunks) is exercised.
  process.stderr.write("remote: Enumerating objects: 120, done.\r");
  process.stderr.write("Receiving objects: 100% (120/120), 1.10 MiB | 5.00 MiB/s, done.\r\n");
  if (mode === "auth") {
    process.stderr.write(`fatal: could not read Username for '${remote}': terminal prompts disabled\n`);
    process.exit(128);
  }
  if (mode === "hostkey") {
    // What BatchMode turns the "trust this host?" question into. Note it ALSO
    // ends with the generic "Could not read from remote repository." line.
    process.stderr.write("Host key verification failed.\n");
    process.stderr.write("fatal: Could not read from remote repository.\n");
    process.exit(128);
  }
  if (mode === "sshauth") {
    process.stderr.write("git@github.com: Permission denied (publickey).\n");
    process.stderr.write("fatal: Could not read from remote repository.\n\n");
    process.stderr.write("Please make sure you have the correct access rights\nand the repository exists.\n");
    process.exit(128);
  }
  if (mode === "missing") {
    process.stderr.write(`remote: Repository not found.\nfatal: repository '${remote}' not found\n`);
    process.exit(128);
  }
  if (mode === "fail") {
    process.stderr.write("fatal: the remote end hung up unexpectedly\n");
    process.exit(128);
  }
  // A marker the specs can read back to prove WHICH remote was cloned.
  try { fs.writeFileSync(path.join(dest, ".git", "fake-origin"), String(remote)); } catch {}
  process.exit(0);
}

// ── worktree registry ─────────────────────────────────────────────────────────
// `worktree list --porcelain` and `status --porcelain` are what `launch` reads
// before ADOPTING an existing worktree (src/worktreeAdopt.ts), and neither can
// be derived from the directories the fake `worktree add` creates: a test needs
// a worktree that is dirty, on an unexpected branch, or living outside
// `.claude/worktrees/`, and — the case the real bug was about — a directory
// that exists where a worktree would be WITHOUT being one. So the registry is
// explicit: FAKE_GIT_STATE holds `{ worktrees: [{ root, path, branch, dirty }] }`
// (`dirty` is the `status --porcelain` lines), seeded by specs and appended to
// by the fake `worktree add` so a create-then-adopt sequence needs no seeding.
const STATE = process.env.FAKE_GIT_STATE;
function readState() {
  try { return { worktrees: [], ...JSON.parse(fs.readFileSync(STATE, "utf-8")) }; } catch { return { worktrees: [] }; }
}
function real(p) { try { return fs.realpathSync(p); } catch { return p; } }
/** The main checkout `dir` belongs to: a registered root or worktree that is
 *  `dir` or an ancestor of it, else the nearest ancestor holding a `.git`. */
function mainRootOf(dir) {
  const d = real(dir);
  const within = (p) => d === real(p) || d.startsWith(real(p) + "/");
  for (const w of readState().worktrees) {
    if (within(w.root) || within(w.path)) return real(w.root);
  }
  let cur = d;
  while (cur && cur !== "/") {
    if (fs.existsSync(path.join(cur, ".git"))) return cur;
    cur = path.dirname(cur);
  }
  return undefined;
}

if (args[0] === "worktree" && args[1] === "add") {
  // The worktree path is the argument that looks like an absolute path; the
  // branch is `-b`'s value, else the positional after the path (the
  // existing-branch form). Registered so a later `worktree list` finds it.
  const rest = args.slice(2);
  const wt = rest.find((a) => a.startsWith("/"));
  const b = rest.indexOf("-b");
  const branch = b >= 0 ? rest[b + 1] : rest[rest.indexOf(wt) + 1];
  if (wt) {
    try { fs.mkdirSync(wt, { recursive: true }); } catch {}
    if (STATE) {
      const s = readState();
      s.worktrees.push({ root: real(root), path: real(wt), branch: branch ?? "worktree-unnamed", dirty: [] });
      try { fs.writeFileSync(STATE, JSON.stringify(s, null, 2)); } catch {}
    }
  }
  process.exit(0);
}

if (args[0] === "worktree" && args[1] === "list") {
  const main = mainRootOf(root);
  if (!main) {
    process.stderr.write("fatal: not a git repository (or any of the parent directories): .git\n");
    process.exit(128);
  }
  const record = (p, branch) => `worktree ${p}\nHEAD 0000000000000000000000000000000000000000\nbranch refs/heads/${branch}\n\n`;
  let out = record(main, "main");
  for (const w of readState().worktrees) {
    if (real(w.root) === main) out += record(real(w.path), w.branch);
  }
  process.stdout.write(out);
  process.exit(0);
}

if (args[0] === "status") {
  const here = real(root);
  const w = readState().worktrees.find((x) => real(x.path) === here);
  process.stdout.write((w?.dirty ?? []).map((l) => `${l}\n`).join(""));
  process.exit(0);
}

process.exit(0);
